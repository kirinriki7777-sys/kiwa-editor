{
  "name": "Kiwa Kinari",
  "type": "light",
  "colors": {
    "editor.background": "#f6f1e3",
    "editor.foreground": "#2d2a22",
    "editorCursor.foreground": "#3f7a3a",
    "editor.selectionBackground": "#e2d9bf",
    "editor.lineHighlightBackground": "#efe8d4",
    "editorLineNumber.foreground": "#6a624f",
    "editorLineNumber.activeForeground": "#3f7a3a",
    "editorWhitespace.foreground": "#d5cbb2",
    "editorIndentGuide.background": "#d5cbb2",
    "editorIndentGuide.activeBackground": "#6a624f",
    "editor.findMatchBackground": "#e2d9bf",
    "editor.wordHighlightBackground": "#efe8d4",
    "editor.wordHighlightStrongBackground": "#e2d9bf"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#2d2a22"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a735f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8b3a62"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#3a362c"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#2f6f6a"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#3f6a1f"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#24506e"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#6b4fa0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9a4a12"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f6f6a"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#8b3a62"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#3f6a1f"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#3f7a3a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#2d2a22",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#2d2a22",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Raw",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9a4a12"
      }
    },
    {
      "name": "Links",
      "scope": [
        "meta.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#3f6a1f"
      }
    },
    {
      "name": "Quotes",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#7a735f"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#b3261e"
      }
    }
  ]
}
