{
  "name": "Kiwa Kiri",
  "type": "light",
  "colors": {
    "editor.background": "#eef0f4",
    "editor.foreground": "#22252b",
    "editorCursor.foreground": "#6b4fc4",
    "editor.selectionBackground": "#d9d4f0",
    "editor.lineHighlightBackground": "#e6e9f0",
    "editorLineNumber.foreground": "#5c6370",
    "editorLineNumber.activeForeground": "#6b4fc4",
    "editorWhitespace.foreground": "#c9ced8",
    "editorIndentGuide.background": "#c9ced8",
    "editorIndentGuide.activeBackground": "#6b4fc4",
    "editorBracketMatch.background": "#6b4fc438",
    "editorBracketMatch.border": "#6b4fc4",
    "editorBracketMatch.foreground": "#6b4fc4",
    "editorBracketPairGuide.activeBackground1": "#6b4fc4",
    "editorStickyScroll.border": "#8f97a6",
    "editor.findMatchBackground": "#d9d4f0",
    "editor.wordHighlightBackground": "#e6e9f0",
    "editor.wordHighlightStrongBackground": "#d9d4f0"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#22252b"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c7480",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#6b4fc4"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#3a3f48"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#2f6b3a"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#0f6e8c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#22252b"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#b3261e"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9b3d12"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2f6b3a"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#6b4fc4"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#0f6e8c"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6b4fc4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#22252b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#22252b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Raw",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9b3d12"
      }
    },
    {
      "name": "Links",
      "scope": [
        "meta.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0f6e8c"
      }
    },
    {
      "name": "Quotes",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6c7480"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#b3261e"
      }
    }
  ]
}
