{
  "name": "Kiwa Mori",
  "type": "dark",
  "colors": {
    "editor.background": "#1a201c",
    "editor.foreground": "#d3dcd4",
    "editorCursor.foreground": "#8fcf8a",
    "editor.selectionBackground": "#2f3d33",
    "editor.lineHighlightBackground": "#202822",
    "editorLineNumber.foreground": "#86958a",
    "editorLineNumber.activeForeground": "#8fcf8a",
    "editorWhitespace.foreground": "#2f3a32",
    "editorIndentGuide.background": "#2f3a32",
    "editorIndentGuide.activeBackground": "#8fcf8a",
    "editorBracketMatch.background": "#8fcf8a38",
    "editorBracketMatch.border": "#8fcf8a",
    "editorBracketMatch.foreground": "#8fcf8a",
    "editorBracketPairGuide.activeBackground1": "#8fcf8a",
    "editorStickyScroll.border": "#4a5a4e",
    "editor.findMatchBackground": "#2f3d33",
    "editor.wordHighlightBackground": "#202822",
    "editor.wordHighlightStrongBackground": "#2f3d33"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#d3dcd4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6f8a74",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#d7a5e0"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#c3cec5"
      }
    },
    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#9fd4c8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#a8d8a0"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cfe3d4"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f0b27a"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#e6c384"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9fd4c8"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#d7a5e0"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#a8d8a0"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8fcf8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#d3dcd4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#d3dcd4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Raw",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#e6c384"
      }
    },
    {
      "name": "Links",
      "scope": [
        "meta.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a8d8a0"
      }
    },
    {
      "name": "Quotes",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6f8a74"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#e5484d"
      }
    }
  ]
}
